# Optional-download hashes refer to the exact GitHub blob bytes on every platform.
/assets/fonts/**/OFL.txt text eol=lf
/assets/fonts/**/*.ttf binary
/assets/accessories/fonts.json text eol=lf

# Dictionary archives and multipart sources keep their published bytes.
/assets/dictionaries/*.zip binary
/assets/dictionaries/*.zip.part* binary
/assets/accessories/dictionaries.json text eol=lf
